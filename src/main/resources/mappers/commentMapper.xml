<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sns.comment.domain.">
    <insert
            id = "insertComment"
            parameterType = "com.sns.comment.domain.Comment"
    >
        INSERT INTO `comment`
        (
        ,`postId`
        ,`userId`
        ,`content`
        ,`createdAt`
        ,`updatedAt`
        )
        Values
        (
        #{postId}
        ,#{userId}
        ,#{content}
        ,NOW()
        ,NOW()
        )

    </insert>


</mapper>